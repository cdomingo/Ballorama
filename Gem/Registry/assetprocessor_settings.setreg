{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder Ballorama/Assets": {
                    "watch": "@GEMROOT:Ballorama@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder Ballorama/Registry": {
                    "watch": "@GEMROOT:Ballorama@/Registry",
                    "recursive": 1,
                    "order": 102
                }
            }
        }
    }
}
